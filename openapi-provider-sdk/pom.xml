<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.chenyilei2016</groupId>
  <artifactId>openapi-provider-sdk</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>&#x5F00;&#x653E;&#x5E73;&#x53F0;&#x5185;&#x90E8;&#x670D;&#x52A1;&#x63A5;&#x5165; SDK</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <spring.boot2.version>2.7.18</spring.boot2.version>
    <spring.boot4.version>4.0.7</spring.boot4.version>
    <dubbo.version>2.7.8</dubbo.version>
    <sdk.dubbo.version>2.7.8</sdk.dubbo.version>
    <sdk.test.jvm.args></sdk.test.jvm.args>
  </properties>
  <modules>
    <module>openapi-provider-sdk-core</module>
    <module>openapi-provider-sdk-spring-boot2-starter</module>
    <module>openapi-provider-sdk-dubbo-apache</module>
  </modules>
  <profiles>
    <profile>
      <id>sample</id>
      <modules>
        <module>samples/provider</module>
      </modules>
    </profile>
    <profile>
      <id>jakarta</id>
      <activation>
        <jdk>[17,)</jdk>
      </activation>
      <properties>
        <!-- 仅旧2.7编译基线的单测需要Javassist反射；实际Boot4宿主使用Dubbo3.3.6，无此参数。 -->
        <sdk.test.jvm.args>--add-opens=java.base/java.lang=ALL-UNNAMED</sdk.test.jvm.args>
      </properties>
      <modules>
        <module>openapi-provider-sdk-spring-boot4-starter</module>
      </modules>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <argLine>-DsocksProxyHost= ${sdk.test.jvm.args}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
