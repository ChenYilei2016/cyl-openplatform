<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chenyilei2016</groupId>
    <artifactId>openapi-provider-sdk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>openapi-provider-sdk-sample</artifactId>
  <properties>
    <sample.boot.major>2</sample.boot.major>
    <sample.boot.version>${spring.boot2.version}</sample.boot.version>
    <sample.web.artifact>spring-boot-starter-web</sample.web.artifact>
  </properties>
  <profiles>
    <profile>
      <id>boot4</id>
      <properties>
        <sample.boot.major>4</sample.boot.major>
        <sample.boot.version>${spring.boot4.version}</sample.boot.version>
        <sample.web.artifact>spring-boot-starter-webmvc</sample.web.artifact>
        <maven.compiler.release>17</maven.compiler.release>
      </properties>
    </profile>
    <profile>
      <id>both-protocols</id>
      <activation><property><name>!sample.protocol</name></property></activation>
      <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>${sample.web.artifact}</artifactId></dependency>
        <dependency><groupId>org.apache.dubbo</groupId><artifactId>dubbo</artifactId><version>${dubbo.version}</version></dependency>
      </dependencies>
    </profile>
    <profile>
      <id>http-only</id>
      <activation><property><name>sample.protocol</name><value>http</value></property></activation>
      <dependencies><dependency><groupId>org.springframework.boot</groupId><artifactId>${sample.web.artifact}</artifactId></dependency></dependencies>
      <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <configuration><excludes><exclude>**/SampleDubbo*.java</exclude></excludes></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>dubbo-only</id>
      <activation><property><name>sample.protocol</name><value>dubbo</value></property></activation>
      <dependencies><dependency><groupId>org.apache.dubbo</groupId><artifactId>dubbo</artifactId><version>${dubbo.version}</version></dependency></dependencies>
      <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <configuration><excludes><exclude>**/SampleHttp*.java</exclude></excludes></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${sample.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>io.github.chenyilei2016</groupId>
      <artifactId>openapi-provider-sdk-spring-boot${sample.boot.major}-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
  <build>
    <finalName>openapi-provider-sdk-sample</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${sample.boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>io.github.chenyilei2016.openapi.sample.SampleProviderApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
